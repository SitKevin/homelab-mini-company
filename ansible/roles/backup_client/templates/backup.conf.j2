# /etc/restic/backup.conf - generated by Ansible (role backup_client), do not edit by hand
BACKUP_PATHS=({% for p in backup_paths %}"{{ p }}"{{ ' ' if not loop.last }}{% endfor %})
KEEP_DAILY={{ backup_keep_daily }}
KEEP_WEEKLY={{ backup_keep_weekly }}
KEEP_MONTHLY={{ backup_keep_monthly }}
{% if backup_pre_commands %}

# Consistent dumps taken before restic reads the files
pre_backup() {
{% for cmd in backup_pre_commands %}
    {{ cmd }}
{% endfor %}
}
{% endif %}
