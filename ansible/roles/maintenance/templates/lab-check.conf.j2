# /etc/homelab/lab-check.conf - generated by Ansible from the inventory, do not edit by hand
DNS_SERVER={{ bastion_ip }}
DOMAIN={{ domain }}
NODES="{% for h in groups['homelab'] %}{{ h }}={{ hostvars[h].ansible_host }}{{ ' ' if not loop.last }}{% endfor %}"
GITEA_URL={{ maintenance_gitea_url }}
CERT_HOST={{ maintenance_cert_host }}
CERT_WARN_DAYS={{ maintenance_cert_warn_days }}
