# /etc/prometheus/prometheus.yml - generated by Ansible (role prometheus), do not edit by hand
global:
  scrape_interval: {{ prometheus_scrape_interval }}
  evaluation_interval: {{ prometheus_scrape_interval }}

alerting:
  alertmanagers:
    - static_configs:
        - targets: ["{{ alertmanager_listen | default('127.0.0.1:9093') }}"]

rule_files:
  - /etc/prometheus/rules/*.yml

scrape_configs:
  - job_name: prometheus
    static_configs:
      - targets: ["{{ prometheus_listen }}"]

  # Every host of the inventory; "instance" = hostname instead of ip:port
  - job_name: node
    static_configs:
{% for h in groups['homelab'] %}
      - targets: ["{{ '127.0.0.1' if h in groups['monitoring'] else hostvars[h].ansible_host }}:9100"]
        labels:
          instance: {{ h }}
{% endfor %}
