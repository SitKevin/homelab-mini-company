# /etc/prometheus/prometheus.yml - generated by Ansible (role prometheus), do not edit by hand
global:
  scrape_interval: {{ prometheus_scrape_interval }}
  evaluation_interval: {{ prometheus_scrape_interval }}

alerting:
  alertmanagers:
    - static_configs:
        - targets: ["{{ alertmanager_listen | default('127.0.0.1:9093') }}"]

rule_files:
  - /etc/prometheus/rules/*.yml

scrape_configs:
  - job_name: prometheus
    static_configs:
      - targets: ["{{ prometheus_listen }}"]

  # Every host of the inventory; "instance" = hostname instead of ip:port
  - job_name: node
    static_configs:
{% for h in groups['homelab'] %}
      - targets: ["{{ '127.0.0.1' if h in groups['monitoring'] else hostvars[h].ansible_host }}:9100"]
        labels:
          instance: {{ h }}
{% endfor %}

  # PostgreSQL metrics from every host of the "db" group
  - job_name: postgres
    static_configs:
{% for h in groups['db'] %}
      - targets: ["{{ hostvars[h].ansible_host }}:9187"]
        labels:
          instance: {{ h }}
{% endfor %}

  # Blackbox: Prometheus asks the exporter to probe each URL (standard relabelling)
  - job_name: blackbox_https
    metrics_path: /probe
    params:
      module: [http_2xx]
    static_configs:
      - targets:
{% for url in prometheus_blackbox_targets %}
          - {{ url }}
{% endfor %}
    relabel_configs:
      - source_labels: [__address__]
        target_label: __param_target     # the URL to probe
      - source_labels: [__param_target]
        target_label: instance           # show the URL, not the exporter address
      - target_label: __address__
        replacement: {{ prometheus_blackbox_listen }}   # scrape the exporter itself
