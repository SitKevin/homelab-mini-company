# Apply: sudo ldapmodify -Q -Y EXTERNAL -H ldapi:/// -f tls.ldif
# Key BEFORE cert, otherwise slapd may reject the change with error (80).
# olcSecurity ssf=1 -> a plain (unencrypted) network connection fails with "Confidentiality required (13)";
#   StartTLS (ssf >= 128) and the local ldapi:/// socket (ssf 71) are allowed.
# Do NOT use tls=1: it requires a TLS layer, which ldapi:/// never has, so root can no longer
#   change cn=config with -Y EXTERNAL (see docs/postmortems/2026-10-30-ldap-cn-config-lockout.md).
dn: cn=config
changetype: modify
replace: olcTLSCACertificateFile
olcTLSCACertificateFile: /etc/ldap/tls/ca.crt
-
replace: olcTLSCertificateKeyFile
olcTLSCertificateKeyFile: /etc/ldap/tls/ldap.key
-
replace: olcTLSCertificateFile
olcTLSCertificateFile: /etc/ldap/tls/ldap.crt
-
replace: olcSecurity
olcSecurity: ssf=1
