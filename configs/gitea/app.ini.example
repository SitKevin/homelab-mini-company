; web01: /etc/gitea/app.ini  - SANITIZED EXCERPT (only the settings changed in Phase 2)
; The real file is generated by the web installer and contains secrets
; (DB password, SECRET_KEY, INTERNAL_TOKEN, JWT_SECRET) -> never commit it.
; Permissions:  /etc/gitea = root:git 750,  app.ini = 640

[server]
DOMAIN     = git.sitkevin.duckdns.org
SSH_DOMAIN = git.sitkevin.duckdns.org
HTTP_ADDR  = 127.0.0.1          ; only reachable through Nginx
HTTP_PORT  = 3000
ROOT_URL   = https://git.sitkevin.duckdns.org/

[database]
DB_TYPE  = postgres
HOST     = 192.168.196.12:5432
NAME     = gitea
USER     = gitea
PASSWD   = CHANGE_ME
SSL_MODE = require              ; encrypt web01 -> db01

[service]
DISABLE_REGISTRATION = true     ; accounts are created by IT (LDAP in step 5)
REQUIRE_SIGNIN_VIEW  = true     ; private company instance
